# VA Matching Platform — environment configuration
# Copy to .env and fill in real values. Never commit .env.

# ──────────────────────────────────────────────────────────────
# Core (required)
# ──────────────────────────────────────────────────────────────
# PostgreSQL for app data (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/va_matching

# Canonical auth service uses SYNC engine; use sqlite for isolation or psycopg2 URL
AUTH_DATABASE_URL=sqlite:///./auth.db

# Canonical SalesLedger stores payment journal here (SQLite file path)
PAYMENT_LEDGER_DB=./sales_ledger.db

# JWT secret (generate: `openssl rand -hex 32`)
SECRET_KEY=your-secret-key-change-in-production

# Encryption for stored credentials (OAuth tokens, etc.)
# Generate: `openssl rand -base64 32`
CREDENTIAL_ENCRYPTION_KEY=

# ──────────────────────────────────────────────────────────────
# Stripe (required for payments, webhooks, Connect onboarding)
# ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Connect (VA payout onboarding)
CONNECT_RETURN_URL=https://yourdomain.com/payout/onboarding/complete
CONNECT_REFRESH_URL=https://yourdomain.com/payout/onboarding/refresh

# ──────────────────────────────────────────────────────────────
# Email notifications (canonical EmailChannel)
# ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME="VA Matching Platform"

# ──────────────────────────────────────────────────────────────
# External sourcing APIs (optional — mock adapters used if missing)
# ──────────────────────────────────────────────────────────────
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
FIVERR_CLIENT_ID=
FIVERR_CLIENT_SECRET=
TOPTAL_CLIENT_ID=
TOPTAL_CLIENT_SECRET=

# ──────────────────────────────────────────────────────────────
# Platform tuning (optional; defaults in marketplace/config.py)
# ──────────────────────────────────────────────────────────────
# DB_ECHO=false
# STRIPE_PLATFORM_FEE_RATE=0.20
# STRIPE_MONTHLY_FEE=200.00
# PLACEMENT_FEE_REFUND_WINDOW_DAYS=14
# VETTING_MIN_SCORE=0.6
# ONBOARDING_TRIAL_DAYS=14
# MONTHLY_FEE_TRIAL_DAYS=14