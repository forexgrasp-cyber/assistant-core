# Retention Analytics Platform - Environment Configuration
# Copy to .env and fill in values

# Application
APP_NAME="Retention Analytics Platform"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8766
API_URL=http://localhost:8765
MCP_URL=http://localhost:8767

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/retention_analytics
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ClickHouse (Analytics Warehouse)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=retention_analytics

# Authentication (shared.auth + WorkOS)
AUTH_SECRET_KEY=your-secret-key-here-min-32-chars
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
WORKOS_API_KEY=sk_...
WORKOS_CLIENT_ID=client_...
WORKOS_REDIRECT_URI=http://localhost:8766/callback
WORKOS_COOKIE_PASSWORD=your-cookie-password-32-chars

# Multi-tenancy
TENANT_HEADER=x-agency-slug
DEFAULT_TENANT=demo

# Billing (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY_PER_CLIENT=price_...  # $50/client/month
STRIPE_PRICE_SEAT=price_...  # $10/seat/month
STRIPE_TRIAL_DAYS=30

# Platform OAuth Credentials
KLAVIYO_CLIENT_ID=...
KLAVIYO_CLIENT_SECRET=...
KLAVIYO_REDIRECT_URI=http://localhost:8766/connect/klaviyo/callback

ATTENTIVE_CLIENT_ID=...
ATTENTIVE_CLIENT_SECRET=...
ATTENTIVE_REDIRECT_URI=http://localhost:8766/connect/attentive/callback

POSTSCRIPT_CLIENT_ID=...
POSTSCRIPT_CLIENT_SECRET=...
POSTSCRIPT_REDIRECT_URI=http://localhost:8766/connect/postscript/callback

OMNISEND_CLIENT_ID=...
OMNISEND_CLIENT_SECRET=...
OMNISEND_REDIRECT_URI=http://localhost:8766/connect/omnisend/callback

SENDLANE_CLIENT_ID=...
SENDLANE_CLIENT_SECRET=...
SENDLANE_REDIRECT_URI=http://localhost:8766/connect/sendlane/callback

SHOPIFY_API_KEY=...
SHOPIFY_API_SECRET=...
SHOPIFY_REDIRECT_URI=http://localhost:8766/connect/shopify/callback
SHOPIFY_SCOPES=read_orders,read_customers,read_products,read_fulfillments

RECHARGE_CLIENT_ID=...
RECHARGE_CLIENT_SECRET=...
RECHARGE_REDIRECT_URI=http://localhost:8766/connect/recharge/callback

SKIO_CLIENT_ID=...
SKIO_CLIENT_SECRET=...
SKIO_REDIRECT_URI=http://localhost:8766/connect/skio/callback

LOOP_CLIENT_ID=...
LOOP_CLIENT_SECRET=...
LOOP_REDIRECT_URI=http://localhost:8766/connect/loop/callback

STAY_AI_CLIENT_ID=...
STAY_AI_CLIENT_SECRET=...
STAY_AI_REDIRECT_URI=http://localhost:8766/connect/stay-ai/callback

ORDERGROOVE_CLIENT_ID=...
ORDERGROOVE_CLIENT_SECRET=...
ORDERGROOVE_REDIRECT_URI=http://localhost:8766/connect/ordergroove/callback

ALIA_CLIENT_ID=...
ALIA_CLIENT_SECRET=...
ALIA_REDIRECT_URI=http://localhost:8766/connect/alia/callback

# Encryption (for credentials at rest)
ENCRYPTION_KEY=your-32-byte-base64-encoded-key
KMS_KEY_ID=alias/retention-analytics

# Alerting (ntfy)
NTFY_TOPIC=retention-analytics-alerts
NTFY_URL=https://ntfy.sh

# Monitoring
SENTRY_DSN=https://...@sentry.io/...
DATADOG_API_KEY=...
DATADOG_APP_KEY=...

# AI / MCP
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-...
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_PATH=./data/chroma

# Reporting
PLAYWRIGHT_BROWSER_PATH=/usr/bin/chromium
REPORT_TEMPLATE_PATH=./apps/api/templates/reports

# Slack
SLACK_CLIENT_ID=...
SLACK_CLIENT_SECRET=...
SLACK_SIGNING_SECRET=...
SLACK_REDIRECT_URI=http://localhost:8766/connect/slack/callback

# File Storage
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
S3_BUCKET=retention-analytics-platform
S3_RAW_PREFIX=raw/
S3_REPORTS_PREFIX=reports/

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Feature Flags
ENABLE_MCP=true
ENABLE_WHITELABEL=true
ENABLE_SLACK=true
ENABLE_AI_SUMMARIES=true

# Sync Configuration
SYNC_SCHEDULE_CRON=0 0 * * *  # Daily at midnight UTC
SYNC_BACKFILL_DAYS=365
SYNC_CHUNK_DAYS=7
SYNC_MAX_RETRIES=3
SYNC_RETRY_DELAY=300

# Attribution
ATTRIBUTION_CLICK_WINDOW_EMAIL=7
ATTRIBUTION_CLICK_WINDOW_SMS=1
ATTRIBUTION_CLICK_WINDOW_PUSH=1
ATTRIBUTION_OPEN_WINDOW_EMAIL=1
ATTRIBUTION_CHANNEL_PRIORITY=email,sms,push