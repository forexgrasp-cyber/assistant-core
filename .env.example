# Production Environment Variables
# Copy this file to .env and fill in the values

# Database
POSTGRES_DB=retention
POSTGRES_USER=retention
POSTGRES_PASSWORD=changeme_secure_password

# Redis
REDIS_PASSWORD=changeme_redis_password

# Security
SECRET_KEY=changeme_very_long_random_string_at_least_32_chars
JWT_SECRET_KEY=changeme_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# API
ENVIRONMENT=production
LOG_LEVEL=INFO
CORS_ORIGINS=https://yourdomain.com,https://dev.yourdomain.com

# Frontend
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com

# Monitoring
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme_grafana_password

# Email (for notifications)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=Retention Analytics <noreply@yourdomain.com>

# External Services
SENDGRID_API_KEY=your_sendgrid_key
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
SES_FROM_EMAIL=noreply@yourdomain.com

# Webhook
WEBHOOK_SECRET=changeme_webhook_secret

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_PREDICTIVE=true
ENABLE_REAL_TIME=true