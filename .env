# Retention Analytics Platform - Development Environment
# Copy to .env.local for local overrides

# Application
APP_NAME="Retention Analytics Platform"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8766
API_URL=http://localhost:8765
MCP_URL=http://localhost:8767

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/retention_analytics
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/retention_analytics

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=retention_analytics

# Authentication
AUTH_SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# WorkOS (optional - for production)
# WORKOS_API_KEY=sk_...
# WORKOS_CLIENT_ID=client_...
# WORKOS_REDIRECT_URI=http://localhost:8766/callback
# WORKOS_COOKIE_PASSWORD=your-cookie-password-32-chars-long

# MFA
MFA_ISSUER_NAME=Retention Analytics

# Passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Retention Analytics

# Billing (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY_PER_CLIENT=price_...
STRIPE_PRICE_SEAT=price_...
STRIPE_TRIAL_DAYS=30
BILLING_EMAIL=billing@retention-analytics.com

# Email Provider (AWS SES)
SES_REGION=us-east-1
SES_ACCESS_KEY=
SES_SECRET_KEY=
SES_CONFIGURATION_SET=
DEFAULT_FROM_EMAIL=noreply@retention-analytics.com
DEFAULT_FROM_NAME=Retention Analytics
TRACKING_DOMAIN=

# SMS Provider (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
DEFAULT_FROM_NUMBER=
DEFAULT_COUNTRY_CODE=US

# Push Provider (FCM)
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# Push Provider (APNs)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=

# Push Provider (Web Push VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:push@retention-analytics.com

# Alerting (ntfy)
NTFY_TOPIC=retention-analytics-alerts
NTFY_URL=https://ntfy.sh

# Monitoring
SENTRY_DSN=

# AI / MCP
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_PATH=./data/chroma
ENABLE_MCP=true
MCP_PORT=8767
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_TEMPERATURE=0.1
MAX_TOKENS=4096

# File Storage (S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=retention-analytics-platform
S3_RAW_PREFIX=raw/
S3_REPORTS_PREFIX=reports/
S3_BACKUPS_PREFIX=backups/
CLOUDFRONT_DOMAIN=

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
API_RATE_LIMIT_REQUESTS=1000
API_RATE_LIMIT_WINDOW=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW=60

# Feature Flags
ENABLE_MCP=true
ENABLE_WHITELABEL=true
ENABLE_SLACK=true
ENABLE_AI_SUMMARIES=true
ENABLE_PREDICTIVE=true
ENABLE_AB_TESTING=true
ENABLE_MARKETPLACE=true
ENABLE_VERTICAL_PACKS=true

# Sync
SYNC_SCHEDULE_CRON=0 0 * * *
SYNC_BACKFILL_DAYS=365
SYNC_CHUNK_DAYS=7
SYNC_MAX_RETRIES=3
SYNC_RETRY_DELAY=300
SYNC_MAX_CONCURRENT=10

# Attribution
ATTRIBUTION_CLICK_WINDOW_EMAIL=7
ATTRIBUTION_CLICK_WINDOW_SMS=1
ATTRIBUTION_CLICK_WINDOW_PUSH=1
ATTRIBUTION_OPEN_WINDOW_EMAIL=1
ATTRIBUTION_CHANNEL_PRIORITY=email,sms,push
USE_ML_ATTRIBUTION=true
ML_MODEL_PATH=
CONFIDENCE_THRESHOLD=0.7