# Tutor Service Environment Variables

# App
APP_NAME=Tutor Service
VERSION=2026.11.3
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite+aiosqlite:///./tutor.db
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Shared Canonical Services
SHARED_CANONICAL_SERVICES_VERSION=2026.11.3

# AI/LLM - Paid providers (optional)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
DEFAULT_MODEL=gpt-4-turbo-preview

# Free LLM providers from shared.llm (optional - enhance free tier)
# Get free API keys from:
#   OpenRouter: https://openrouter.ai/keys (free tier available)
#   Groq: https://console.groq.com/keys (free tier available)
#   Google AI: https://aistudio.google.com/apikey (free tier available)
#   NVIDIA: https://build.nvidia.com/explore/discover (free tier available)
#   Cohere: https://dashboard.cohere.ai/api-keys (free tier available)
#   Together: https://api.together.xyz/settings/api-keys (free tier available)
#   Mistral: https://console.mistral.ai/api-keys (free tier available)
#   Cloudflare: https://dash.cloudflare.com/profile/api-tokens (free tier available)
#   Cerebras: https://cloud.cerebras.ai/ (free tier available)
OPENROUTER_API_KEY=your-openrouter-api-key
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key
COHERE_API_KEY=your-cohere-api-key
TOGETHER_API_KEY=your-together-api-key
MISTRAL_API_KEY=your-mistral-api-key
CLOUDFLARE_AI_TOKEN=your-cloudflare-ai-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CEREBRAS_API_KEY=your-cerebras-api-key

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@tutor.yourdomain.com

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800