# AI Assistant Environment Configuration
# Copy this file and fill in your actual credentials
#
#   cp .env.example .env    (Windows: Copy-Item .env.example .env)

# ============================================================
# CORE SECURITY (REQUIRED - Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
# ============================================================
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
POSTGRES_PASSWORD=your-postgres-password-change-me
# Password of the ai_assistant DB role - must MATCH .postgres_password
# (the compose postgres secret) because docker-compose.ai.yml builds
# DATABASE_URL from it. On the VPS both files live in ai-assistant/ next to
# deploy-ai.sh and are never committed.
AI_DB_PASSWORD=your-postgres-password-change-me
PII_ENCRYPTION_KEY=your-pii-encryption-key-32-chars-min
CREDENTIAL_ENCRYPTION_KEY=your-credential-encryption-key-32-chars-min

# ============================================================
# LLM CONFIGURATION (Optional - Free tier works without these)
# ============================================================
# Primary paid providers (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_MODEL=gpt-4-turbo-preview

# Free LLM Providers (enhance free tier - get keys from respective platforms)
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_AI_API_KEY=
NVIDIA_API_KEY=
TOGETHER_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_API_KEY=
CEREBRAS_API_KEY=

# OpenCode Zen (disabled by default - uses HTTP providers instead)
OPENCODE_ZEN_KEYS=opencode-zen
LLM_DISABLED_PROVIDERS=opencode_zen

# ============================================================
# VOICE / TTS
# ============================================================
ELEVENLABS_API_KEY=

# ============================================================
# TELEPHONY (Configure at least one for voice products)
# ============================================================
# Twilio (recommended for production)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Plivo (alternative)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# SignalWire (alternative)
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_TOKEN=
SIGNALWIRE_SPACE=

# ============================================================
# EMAIL (For conversation exports & notifications)
# ============================================================
# Gmail SMTP (free: 500/day)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@ai.snapford.com

# ============================================================
# EXTERNAL APIs
# ============================================================
YOUTUBE_API_KEY=

# ============================================================
# CORS & DOMAINS
# ============================================================
CORS_ORIGINS=https://ai.snapford.com,https://app.ai.snapford.com,https://api.ai.snapford.com

# ============================================================
# ENVIRONMENT
# ============================================================
ENVIRONMENT=production

# ============================================================
# PLATFORM
# ============================================================
# Where the platform stores local state (sessions, email outbox, settings)
PLATFORM_DATA_DIR=./data/platform