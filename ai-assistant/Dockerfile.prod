# =============================================================================
# AI Assistant - Production Dockerfile (Traefik-native, no proxy of its own)
# =============================================================================
# The shared canonical library is a PRIVATE wheel (not on PyPI). deploy-ai.sh
# stages it into wheels/ before the build:
#
#   wheels/shared_canonical_services-<version>-py3-none-any.whl
#
# requirements.txt AND the private shared wheel are resolved in ONE pip call:
# resolving them separately can produce two different versions of the same
# transitive dep (e.g. anyio) in /wheels, and installing "*.whl" wholesale
# then fails with ResolutionImpossible. A failed install is NEVER hidden
# behind `|| true` - a swallowed pip failure leaves the image with no
# dependencies and the container dies on `import fastapi`.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Stage 1: Build Python dependencies into /wheels (offline-installable)
# -----------------------------------------------------------------------------
FROM python:3.12-slim AS python-builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Wrapper requirements + the private shared wheel, staged by deploy-ai.sh
COPY requirements.txt ./
COPY wheels/ ./wheels/

RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip wheel --no-cache-dir --wheel-dir /wheels \
        -r requirements.txt ./wheels/shared_canonical_services-*.whl

# -----------------------------------------------------------------------------
# Stage 2: Production runtime
# -----------------------------------------------------------------------------
FROM python:3.12-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

RUN groupadd -r appuser && useradd -r -g appuser -d /app -s /bin/bash appuser

WORKDIR /app

# Install the resolved wheel set (offline). Fatal on failure.
COPY --from=python-builder /wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels /wheels/*.whl && \
    rm -rf /wheels

# Application code (wrapper app only; everything reusable is in the wheel)
COPY --chown=appuser:appuser app/ ./app/

RUN mkdir -p /app/data /app/logs && chown -R appuser:appuser /app

USER appuser

# The app has no trusted-host middleware, so a plain Host header is fine;
# Traefik v3 skips unhealthy containers, so a failing check hides the router.
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000

CMD ["gunicorn", "app.main:app", \
     "--workers", "4", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8000", \
     "--timeout", "120", \
     "--keep-alive", "5", \
     "--max-requests", "1000", \
     "--max-requests-jitter", "100", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "--log-level", "info"]
