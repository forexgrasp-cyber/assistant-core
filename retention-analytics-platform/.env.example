# Retention Analytics Platform — environment template
# Copy to .env and fill in. NEVER commit real secrets.
# Only payment providers with keys set here are listed as payment options at runtime.

# --- Core ---
ENVIRONMENT=development          # development | staging | production
JWT_SECRET=change-me             # REQUIRED in production
WEBHOOK_SECRET=change-me         # REQUIRED in production (inbound webhook HMAC)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:47323/retention_analytics
REDIS_URL=redis://localhost:47324/0
CELERY_BROKER_URL=redis://localhost:47324/1
CELERY_RESULT_BACKEND=redis://localhost:47324/2
DATA_DIR=data

# --- VPS deploy (deploy/vps/docker-compose.satellite.yml) ---
# The project directory relative to the build CONTEXT (/opt/sites). The default
# suits a clone with the project at its root; a clone that keeps the project one
# level down (a monorepo mirror) points this at it.
PROJECT_PATH=retention-analytics-platform

# --- Stripe (test keys in dev/test: sk_test_... / pk_test_...; live keys sk_live_... in prod) ---
# No live payment calls are made in tests — webhook signature + idempotency are tested with test keys.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Other payment providers (add the ones you use; only these appear as options) ---
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PADDLE_API_KEY=
# ADYEN_API_KEY=
# AIRWALLEX_API_KEY=
# FONDY_MERCHANT_ID=
# LIQPAY_PUBLIC_KEY=
# LIQPAY_PRIVATE_KEY=
# (see packages/retention_analytics_core/payment_keys.py PROVIDER_ENV_KEYS for all 21)

# --- Integrations ---
SLACK_WEBHOOK_URL=
# AI keys (optional — rule-based fallbacks are built in)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Hiro Analytics (agency platform analytics) ---
HIRO_API_KEY=                          # [OPTIONAL] Hiro API key (Bearer)
HIRO_API_BASE=https://api.hiroanalytics.com/v1   # [OPTIONAL] REST base override
HIRO_MCP_URL=https://mcp.hiroanalytics.com/mcp   # [OPTIONAL] MCP endpoint for Claude/ChatGPT