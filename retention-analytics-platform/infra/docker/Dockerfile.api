# syntax=docker/dockerfile:1
# Multi-stage Dockerfile for the Retention Analytics Platform API (Optimized).
# Stage 1: Build - install dependencies with uv
# Stage 2: Runtime - slim image with only runtime deps, non-root user

ARG PYTHON_VERSION=3.12-slim

FROM python:${PYTHON_VERSION} AS builder
WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_NO_CACHE=0

# Install uv
RUN pip install --no-cache-dir uv

# Copy dependency files first for layer caching
COPY pyproject.toml ./

# Install production dependencies into /app/.venv
RUN uv sync --frozen --no-dev --no-cache

FROM python:${PYTHON_VERSION} AS runtime
WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

# Install runtime-only system deps (already minimal - good!)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r appuser && useradd -r -g appuser -s /bin/false appuser

# Copy virtualenv from builder
COPY --from=builder /app/.venv /app/.venv

# Copy application code (exclude tests, docs)
COPY --chown=appuser:appuser apps/ ./apps/
COPY --chown=appuser:appuser core/ ./core/
COPY --chown=appuser:appuser alembic.ini ./
COPY --chown=appuser:appuser alembic/ ./alembic/

# Switch to non-root user
USER appuser

EXPOSE 47319

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:47319/health/ready', timeout=5)" || exit 1

CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "47319"]
