# syntax=docker/dockerfile:1
# Retention Analytics Platform — API image.
#
# BUILD CONTEXT = the directory that CONTAINS both repositories:
#   - locally:  C:/Users/IhorLeshchuk/PycharmProjects
#   - on the VPS: /opt/sites  (site clone + shared-canonical-services clone)
# The shared package is a private git dependency, so it is copied from the
# context instead of installed from GitHub.
#
#   podman build -f retention-analytics-platform/infra/docker/Dockerfile.api \
#     -t retention-analytics-platform:api .
ARG PYTHON_VERSION=3.12-slim
ARG PROJECT=retention-analytics-platform

FROM docker.io/library/python:${PYTHON_VERSION} AS builder
ARG PROJECT
WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_NO_CACHE=0

RUN pip install --no-cache-dir uv

# Dependency manifest + the local packages the project ships (setuptools finds
# them under ./packages) + the canonical shared checkout (path source).
COPY ${PROJECT}/pyproject.toml ./
COPY ${PROJECT}/packages/ ./packages/
COPY shared-canonical-services/ /shared-canonical-services/

RUN uv sync --no-dev --no-cache

FROM docker.io/library/python:${PYTHON_VERSION} AS runtime
ARG PROJECT
WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libpq5 \
    gosu \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r appuser && useradd -r -g appuser -s /bin/false appuser

COPY --from=builder /app/.venv /app/.venv
# The editable install points at /app/packages (setuptools src-layout), so the
# packages tree must exist in the runtime image too.
COPY --chown=appuser:appuser ${PROJECT}/packages/ ./packages/
# The shared package is installed editable against /shared-canonical-services.
COPY --chown=appuser:appuser shared-canonical-services/ /shared-canonical-services/
COPY --chown=appuser:appuser ${PROJECT}/apps/ ./apps/

RUN mkdir -p /data \
    && chown -R appuser:appuser /app /data
COPY --chown=root:root ${PROJECT}/infra/docker/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh
USER root

EXPOSE 47319

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:47319/health/ready', timeout=5)" || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "47319"]
